# Copy to .env (gitignored). Only AURORA_API_KEY is required.
AURORA_API_KEY=
PORT=3037
# 1 behind Cloudflare (reads CF-Connecting-IP for the per-device rate limit)
TRUST_PROXY=0
# Integrator fee in bps. 0 for the hackathon: a tip jar should not skim.
TIP_FEE_BPS=0
# FEE_RECIPIENT=creatorplatform.near     # required only when TIP_FEE_BPS > 0
MAX_TIP_USD=50
SLIPPAGE_BPS=100
# Only creators in this Firebase list can be tipped (stops the backend being used as a generic swap relay)
# CREATOR_REGISTRY_URL=https://<project>-default-rtdb.firebaseio.com/creators.json
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REQUIRE_CREATOR_USDC_ACCOUNT=1
DATA_FILE=./data/tips.jsonl
