{
  "rules": {
    ".read": false,
    ".write": false,
    "creators": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'wallet', 'category', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "handle": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "wallet": { ".validate": "newData.isString() && newData.val().length >= 32 && newData.val().length <= 44 && newData.val().matches(/^[1-9A-HJ-NP-Za-km-z]+$/)" },
        "project": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
